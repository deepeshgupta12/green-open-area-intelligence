# Gemini auth. Pick ONE of the two modes below.
# Mode 1 (preferred): Vertex AI with a Google Cloud service-account key file.
#   Keep the JSON outside the repo and never commit it.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
GOOGLE_CLOUD_PROJECT=your_gcp_project_id
GOOGLE_CLOUD_LOCATION=global
# Mode 2: Gemini Developer API key from aistudio.google.com (used only if the path above is empty).
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-3.5-flash
GEMINI_TEXT_MODEL=gemini-3.5-flash

APP_ENV=local
APP_NAME=Master Plan Intelligence

DATABASE_URL=sqlite:///./goa_engine.sqlite3

MAX_IMAGE_SIZE_MB=30
DEFAULT_CONFIDENCE_THRESHOLD=0.65